# Copy to .env and fill. .env is gitignored — keep it that way.

# Razorpay test mode
RZP_KEY_ID=rzp_test_xxx
RZP_KEY_SECRET=xxx
RZP_WEBHOOK_SECRET=xxx          # NOT the API secret. Pitfall #1.
RZP_WEBHOOK_SECRET_PREV=        # dual-secret rotation window, E8

# ---- LLM provider -------------------------------------------------
# "anthropic" | "nvidia" | "auto" (prefers whichever key is present)
LLM_PROVIDER=auto

ANTHROPIC_API_KEY=sk-ant-xxx
ANTHROPIC_MODEL=claude-sonnet-5

# NVIDIA NIM - OpenAI-compatible, free tier. Get a key at build.nvidia.com.
# Note: this endpoint supports neither forced tool_choice nor
# nvext.guided_json, so structured output is enforced with
# response_format={"type":"json_schema", strict:true} plus pydantic
# validation. Slightly weaker than Anthropic's forced tool use, which is
# why the gate re-derives everything regardless. The free tier also
# rate-limits under load - the agents degrade to deterministic fallbacks
# when it does, and the console shows exactly when that happened.
NVIDIA_API_KEY=nvapi-xxx
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# nemotron-3-nano-30b-a3b ~4s/call; nemotron-3-super-120b-a12b reasons
# better at ~9s, but the strategist loop has a 15s budget.
NVIDIA_MODEL=nvidia/nemotron-3-nano-30b-a3b

POSTGRES_DSN=postgresql://nishchay:nishchay@localhost:5432/nishchay
REDIS_URL=redis://localhost:6379
KAFKA_BOOTSTRAP=localhost:19092
CLICKHOUSE_URL=http://localhost:8123

# Domain constants
TAT_WINDOW_BANKING_DAYS=1
SETTLE_HORIZON_DAYS=3
MAX_TURNS=6
MAX_TOKENS_PER_RESOLUTION=8000
